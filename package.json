{
  "name": "folio-pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first Chromium PDF viewer powered by Poppler WebAssembly",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "engine:build": "python3 scripts/build-engine.py",
    "build": "tsc --noEmit && vite build && node scripts/package-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:codecs:prepare": "python3 scripts/make-image-fixtures.py",
    "benchmark": "node scripts/benchmark.mjs",
    "release": "npm run build && python3 scripts/release.py",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
